{
  "findings": {
    "archive-shared-worktree": {
      "title": "Archiving an owner keeps a worktree another agent works in until that agent is archived",
      "task": "T20"
    },
    "archive-switched-branch": {
      "title": "Archive no longer deletes the branch a worktree was switched to",
      "task": "T20"
    },
    "worktree-status-fields": {
      "title": "Worktree status gained ownership, owner, borrowers and checkoutState",
      "task": "T20"
    },
    "worktree-launch-failure": {
      "title": "A child whose worktree cannot be created ends stopped, not error and blocked, with a different message",
      "task": "T25"
    },
    "worktree-outside-git-base": {
      "title": "A worktree request outside Git records no base branch, where main records main",
      "task": "T25"
    },
    "icon-no-content": {
      "title": "A missing repository or project icon is 204, not 404",
      "task": "T15"
    },
    "branches-default": {
      "title": "The branch list gained defaultBranch",
      "task": "T17"
    },
    "agent-record-field": {
      "title": "Every local agent record gained runnerManaged",
      "task": "T07"
    },
    "schema-version": {
      "title": "The signed readiness answer reports the branch's 11 extra migrations. Needs an owner decision to become intended",
      "task": "T40"
    }
  },
