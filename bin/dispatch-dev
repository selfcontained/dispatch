#!/usr/bin/env bash
set -euo pipefail

# dispatch-dev — standalone dev-stack helper.
#
# Starts an isolated Postgres DB, API server, and Vite frontend on
# auto-selected free ports. State is persisted to /tmp so that down/status/
# logs/url can find the running stack later.
#
# No tmux or agent-session dependency — just background processes + PID files.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Preflight — fail fast if required tools are missing. Every server script
# runs under bun, so a machine with only node gets an API server that exits
# before it logs anything useful.
preflight_tool() {
  command -v "$1" &>/dev/null && return 0
  echo "Error: $1 is not installed. $2" >&2
  return 1
}
preflight_missing=0
preflight_tool node "Install Node.js: https://nodejs.org" || preflight_missing=1
preflight_tool pnpm "Install it with: npm i -g pnpm" || preflight_missing=1
preflight_tool bun "Install it with: brew install oven-sh/bun/bun (or curl -fsSL https://bun.sh/install | bash)" || preflight_missing=1
[ "$preflight_missing" = 0 ] || exit 1

usage() {
  cat <<'USAGE'
Usage: dispatch-dev <command> [options]

Start an isolated dev environment with its own DB, API server, and
Vite frontend — all on auto-selected free ports.

Commands:
  up        Start DB + API server + Vite frontend
  down      Stop all dev services, keeping the database
  restart   Restart the API + Vite servers, keeping the DB intact
  status    Show which services are running
  logs      Show recent output (default: api; use --vite or --db)
  url       Print the dev server URL

Options:
  --cwd <path>      Working directory (default: current directory)
  --no-db           Skip database (use existing DATABASE_URL)
  --suffix <name>   Explicit stack suffix (default: agent ID or generated)
  --live            Run agents for real (the ACP runtime); default is inert.
                    Also disables the default dev-data seed.
  --no-seed         Skip seeding demo data (seed is on by default for non-live)
  --preserve-agent-hosts
                    Keep live agent hosts running across restart. This opt-in
                    is saved for the stack and reused by later restarts.
  --wipe            down only: also delete the database and the stack's
                    logs. Agents, streams and files are gone for good.
  -f, --follow      Follow log output (used with logs command)

USAGE
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Grab a free port from the OS. Small TOCTOU window between closing the probe
# socket and the actual service binding, but acceptable for dev tooling.
find_free_port() {
  node -e '
    const net = require("net");
    const srv = net.createServer();
    srv.listen(0, "127.0.0.1", () => {
      console.log(srv.address().port);
      srv.close();
    });
  '
}


# One stack per checkout. The suffix names the stack's state file, log
# directory, container and database, so every command has to derive the
# same one: a PID and timestamp would mean `down` never finds what `up`
# started. `--suffix` still runs more than one stack from a checkout.
resolve_suffix() {
  if [ -n "$OPT_SUFFIX" ]; then
    echo "$OPT_SUFFIX"
  elif [ -n "${DISPATCH_AGENT_ID:-}" ]; then
    echo "$DISPATCH_AGENT_ID"
  else
    local root
    root="$(cd "${OPT_CWD:-$(pwd)}" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)" || root=""
    [ -n "$root" ] || root="${OPT_CWD:-$(pwd)}"
    local name
    name="$(basename "$root")"
    # Keep the checkout's name for a readable container, and a short hash of
    # its path so two clones of the same repo never share a stack.
    echo "dev-${name}-$(printf '%s' "$root" | shasum | cut -c1-8)"
  fi
}

state_file() {
  echo "/tmp/dispatch-dev-${SUFFIX}.env"
}

log_dir() {
  echo "/tmp/dispatch-dev-${SUFFIX}"
}

# The tail of a crashed service's log, or where to look when it died before
# writing one (the log is written asynchronously, so an instant exit can
# leave it empty).
report_log() {
  local file="$1"
  if [ -s "$file" ]; then
    echo "Last log lines:" >&2
    tail -n 20 "$file" >&2
  else
    echo "It exited before writing a log. Check: $file" >&2
  fi
}

release_cache_dir() {
  echo "${DEV_CWD}/.dispatch/dev-cache/release-${SUFFIX}"
}

save_state() {
  cat > "$(state_file)" <<EOF
DEV_SUFFIX=${SUFFIX}
DEV_CWD=${DEV_CWD:-}
DEV_DB_PORT=${DEV_DB_PORT:-}
DEV_API_PORT=${DEV_API_PORT:-}
DEV_API_PID=${DEV_API_PID:-}
DEV_VITE_PORT=${DEV_VITE_PORT:-}
DEV_VITE_PID=${DEV_VITE_PID:-}
DEV_CONTAINER_SUFFIX=${DEV_CONTAINER_SUFFIX:-}
DEV_COMPOSE_PROJECT=${DEV_COMPOSE_PROJECT:-}
DEV_NO_DB=${DEV_NO_DB:-0}
DEV_LIVE=${OPT_LIVE:-0}
DEV_NO_SEED=${OPT_NO_SEED:-0}
DEV_PRESERVE_AGENT_HOSTS=${OPT_PRESERVE_AGENT_HOSTS:-0}
DEV_DISPLAY_HOST=${DEV_DISPLAY_HOST:-127.0.0.1}
DEV_LAN_HOST=${DEV_LAN_HOST:-}
DEV_RELEASE_CACHE_DIR=${DEV_RELEASE_CACHE_DIR:-}
EOF
}

load_state() {
  local file
  file="$(state_file)"
  if [ -f "$file" ]; then
    # shellcheck disable=SC1090
    source "$file"
    return 0
  fi
  return 1
}

pid_alive() {
  [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

# Return success when a PID is one of this stack's detached agent hosts.
# Hosts stay parented to the API's wrapper tree even though they lead their
# own process group, so a recursive PPID walk must explicitly preserve them
# during a soft restart.
is_agent_host_pid() {
  local target="${1:-}"
  [ -n "$target" ] || return 1
  local pidfile host_pid
  for pidfile in "$(log_dir)"/agents/*/host.pid; do
    [ -f "$pidfile" ] || continue
    host_pid="$(cat "$pidfile" 2>/dev/null || true)"
    [ "$host_pid" = "$target" ] && return 0
  done
  return 1
}

# Recursively kill a process and all its descendants (depth-first).
# This ensures child processes spawned by npm/tsx are cleaned up even
# when signals don't propagate through the wrapper chain. An opted-in soft
# restart preserves registered agent-host roots (and therefore their process
# groups); default restart and explicit down stop those groups separately.
kill_tree() {
  local pid="${1:-}"
  local sig="${2:-TERM}"
  local preserve_agent_hosts="${3:-0}"
  [ -z "$pid" ] && return 0
  if [ "$preserve_agent_hosts" = "1" ] && is_agent_host_pid "$pid"; then
    return 0
  fi
  local children
  children=$(pgrep -P "$pid" 2>/dev/null) || true
  for child in $children; do
    kill_tree "$child" "$sig" "$preserve_agent_hosts"
  done
  kill -"$sig" "$pid" 2>/dev/null || true
}

# Tree-kill a service PID, wait for exit, then force-kill if needed.
stop_service() {
  local pid="${1:-}"
  local name="${2:-service}"
  local preserve_agent_hosts="${3:-0}"
  if ! pid_alive "$pid"; then
    return 0
  fi
  kill_tree "$pid" TERM "$preserve_agent_hosts"
  local i=0
  while [ $i -lt 10 ] && pid_alive "$pid"; do
    sleep 0.5
    i=$((i + 1))
  done
  if pid_alive "$pid"; then
    kill_tree "$pid" 9 "$preserve_agent_hosts"
  fi
  echo "Stopped ${name} (PID ${pid})"
}

# This machine's address on the network, for a stack bound to every
# interface: what another device on the same network opens. Empty when
# there is no such address to report.
lan_address() {
  local ip=""
  if command -v ipconfig >/dev/null 2>&1; then
    for iface in en0 en1 en2; do
      ip="$(ipconfig getifaddr "$iface" 2>/dev/null || true)"
      [ -n "$ip" ] && break
    done
  fi
  if [ -z "$ip" ] && command -v hostname >/dev/null 2>&1; then
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  fi
  echo "$ip"
}

# Detect docker compose command
detect_compose() {
  if docker compose version &>/dev/null; then
    echo "docker compose"
  elif command -v docker-compose &>/dev/null; then
    echo "docker-compose"
  else
    echo ""
  fi
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_up() {
  local cwd="${OPT_CWD:-$(pwd)}"

  # Check for existing live stack
  if [ -f "$(state_file)" ]; then
    load_state
    if pid_alive "${DEV_API_PID:-}"; then
      echo "Stack '${SUFFIX}' is already running (API PID ${DEV_API_PID}, port ${DEV_API_PORT})."
      echo "Run 'dispatch-dev down' first, or use a different --suffix."
      exit 1
    fi
    # A long-lived stack can have an API that exited while its detached
    # agents are still working. Recover it through the same host-preserving
    # restart path instead of treating the whole stack as disposable.
    if [ "${DEV_PRESERVE_AGENT_HOSTS:-0}" = "1" ]; then
      echo "Recovering stale state for '${SUFFIX}' without stopping agent hosts..."
      cmd_restart
      return
    fi
    # Ordinary dev stacks still clean up all descendants on a fresh up.
    echo "Cleaning stale state for '${SUFFIX}'..."
    cmd_down 2>/dev/null || true
  fi

  mkdir -p "$(log_dir)"
  DEV_CWD="$cwd"
  DEV_RELEASE_CACHE_DIR="$(release_cache_dir)"

  # --- Database ---
  DEV_NO_DB="$OPT_NO_DB"
  if [ "$OPT_NO_DB" != "1" ]; then
    local compose
    compose="$(detect_compose)"
    if [ -z "$compose" ]; then
      echo "Error: docker compose is not available. Is Docker Desktop running?" >&2
      exit 1
    fi

    DEV_CONTAINER_SUFFIX="$SUFFIX"
    DEV_COMPOSE_PROJECT="dispatch-dev-${SUFFIX}"

    local db_attempt=1
    local db_max_attempts=5
    local compose_output
    compose_output="$(log_dir)/db-up.log"
    while [ $db_attempt -le $db_max_attempts ]; do
      DEV_DB_PORT="${RESTART_DB_PORT:-$(find_free_port)}"

      echo "Starting database on port ${DEV_DB_PORT}..."

      if DISPATCH_DB_NAME="$DEV_CONTAINER_SUFFIX" DISPATCH_DB_PORT="$DEV_DB_PORT" \
        $compose -f "${SCRIPT_DIR}/docker-compose.yml" -p "$DEV_COMPOSE_PROJECT" up -d --wait >"$compose_output" 2>&1; then
        cat "$compose_output"
        echo "Database ready on port ${DEV_DB_PORT}"
        break
      fi

      cat "$compose_output"
      if [ -n "${RESTART_DB_PORT:-}" ] || ! grep -q "address already in use" "$compose_output" || [ $db_attempt -eq $db_max_attempts ]; then
        exit 1
      fi

      echo "Database port ${DEV_DB_PORT} was claimed before Docker could bind it; retrying..." >&2
      # Drop the container so the next attempt can bind a different port;
      # the volume it was mounting stays, data and all.
      $compose -f "${SCRIPT_DIR}/docker-compose.yml" -p "$DEV_COMPOSE_PROJECT" down >/dev/null 2>&1 || true
      db_attempt=$((db_attempt + 1))
    done
  fi

  # --- API Server ---
  DEV_API_PORT="${RESTART_API_PORT:-$(find_free_port)}"
  # What the servers bind, and what to print for it. Both the API and Vite
  # already listen on every interface by default, so a stack is reachable
  # from a phone or another laptop; the URLs below say so rather than
  # leaving it to be discovered. 0.0.0.0 is not an address a browser can
  # open, so they use the loopback plus this machine's network address.
  DEV_BIND_HOST="${DISPATCH_HOST:-0.0.0.0}"
  DEV_DISPLAY_HOST="$DEV_BIND_HOST"
  [ "$DEV_DISPLAY_HOST" = "0.0.0.0" ] && DEV_DISPLAY_HOST="127.0.0.1"
  DEV_LAN_HOST=""
  [ "$DEV_BIND_HOST" = "0.0.0.0" ] && DEV_LAN_HOST="$(lan_address)"

  # Build environment
  (

    cd "$cwd"

    # Source .env if present
    if [ -f ".env" ]; then
      set -a
      # shellcheck disable=SC1091
      source ".env"
      set +a
    fi

    # Unset TLS so dev servers run plain HTTP
    unset TLS_CERT TLS_KEY 2>/dev/null || true

    # Override port, session prefix, and agent runtime — always explicit so .env doesn't leak
    export DISPATCH_PORT="$DEV_API_PORT"
    export DISPATCH_DEV_STACK=1
    # Bind to all interfaces so the dev stack is reachable from other devices
    # (phone, another laptop) on the LAN or tailnet, not just this machine.
    export DISPATCH_HOST="${DISPATCH_HOST:-0.0.0.0}"
    if [ "$OPT_LIVE" = "1" ]; then
      export DISPATCH_AGENT_RUNTIME="acp"
    else
      export DISPATCH_AGENT_RUNTIME="inert"
    fi
    # Agent hosts outlive the API server; keep this stack's under its own
    # cache dir so `down` can find them and stacks never share a root.
    export DISPATCH_AGENT_STATE_ROOT="$(log_dir)/agents"

    # Files agents share live with the stack, not in ~/.dispatch, which
    # belongs to the installed Dispatch. The server falls back to that
    # directory when this is unset, and a worktree whose .env predates the
    # media→files rename sets the old name, so the stack states it here
    # rather than trusting whatever .env it inherited.
    export DISPATCH_FILES_ROOT="$(log_dir)/files"

    # Keep the release store out of ~/.dispatch/ — a stale version there
    # surfaces the update-available toast against the dev build.
    export DISPATCH_RELEASE_STORE_PATH="$(log_dir)/release.json"
    export DISPATCH_RELEASE_CANDIDATE_STORE_PATH="$(log_dir)/release-candidate.json"
    export DISPATCH_RELEASE_CACHE_DIR="$DEV_RELEASE_CACHE_DIR"

    if [ "$OPT_NO_DB" != "1" ]; then
      export DATABASE_URL="postgres://dispatch:dispatch@127.0.0.1:${DEV_DB_PORT}/dispatch_${DEV_CONTAINER_SUFFIX}"
    fi

    pnpm run dev >> "$(log_dir)/api.log" 2>&1 &
    echo $! > "$(log_dir)/api.pid"
  )

  DEV_API_PID="$(cat "$(log_dir)/api.pid")"
  echo "API server starting on port ${DEV_API_PORT} (PID ${DEV_API_PID})"

  # Liveness check — wait up to 10s for the port, then verify /health
  local attempts=0
  local port_open=0
  while [ $attempts -lt 20 ]; do
    if ! pid_alive "$DEV_API_PID"; then
      echo "Error: API server exited immediately." >&2
      report_log "$(log_dir)/api.log"
      exit 1
    fi
    if node -e "const s=require('net').createConnection({host:'127.0.0.1',port:${DEV_API_PORT}},()=>{s.end();process.exit(0)});s.on('error',()=>process.exit(1))" 2>/dev/null; then
      port_open=1
      break
    fi
    attempts=$((attempts + 1))
    sleep 0.5
  done

  # Verify the API is actually healthy, not just listening
  if [ "$port_open" = "1" ]; then
    local health_attempts=0
    while [ $health_attempts -lt 10 ]; do
      if curl -fsS -m 2 "http://127.0.0.1:${DEV_API_PORT}/api/v1/health" >/dev/null 2>&1; then
        break
      fi
      if ! pid_alive "$DEV_API_PID"; then
        echo "Error: API server crashed during startup. Last log lines:" >&2
        tail -n 20 "$(log_dir)/api.log" 2>/dev/null >&2 || true
        exit 1
      fi
      health_attempts=$((health_attempts + 1))
      sleep 1
    done
  fi

  # --- Seed demo data (dev-only, explicit) ---
  # Runs after the API is up so the UI has something to render on first load.
  # Not invoked by the server runtime — this is the only code path that seeds.
  # --live and --no-seed both skip it.
  if [ "$OPT_LIVE" != "1" ] && [ "$OPT_NO_SEED" != "1" ] && [ "$OPT_NO_DB" != "1" ]; then
    echo "Seeding demo data..."
    (
      cd "$cwd"
      export DATABASE_URL="postgres://dispatch:dispatch@127.0.0.1:${DEV_DB_PORT}/dispatch_${DEV_CONTAINER_SUFFIX}"
      pnpm --filter @dispatch/server exec tsx src/db/seed/run.ts >> "$(log_dir)/seed.log" 2>&1
    ) || {
      echo "Warning: seed failed. See $(log_dir)/seed.log for details." >&2
    }
  fi

  # --- Vite Frontend ---
  DEV_VITE_PORT="${RESTART_VITE_PORT:-$(find_free_port)}"
  local vite_cache_dir
  vite_cache_dir="$(log_dir)/vite-cache"

  # Keep each dev stack's Vite optimizer cache isolated so concurrent builds,
  # tests, and other live stacks in the same worktree cannot corrupt it.
  rm -rf "$vite_cache_dir" 2>/dev/null || true

  # Build the downloadable browser extension archive before Vite starts. The
  # web production build copies the same archive into its dist output.
  (
    cd "$cwd"
    pnpm --filter @dispatch/browser-extension package >> "$(log_dir)/vite.log" 2>&1
  )

  (
    cd "${cwd}/apps/web"
    # Tell Vite's proxy where the API server is
    env \
      DISPATCH_PORT="$DEV_API_PORT" \
      DISPATCH_VITE_CACHE_DIR="$vite_cache_dir" \
      pnpm exec vite --port "$DEV_VITE_PORT" --host "$DEV_BIND_HOST" \
        >> "$(log_dir)/vite.log" 2>&1 &
    echo $! > "$(log_dir)/vite.pid"
  )

  DEV_VITE_PID="$(cat "$(log_dir)/vite.pid")"
  echo "Vite dev server starting on port ${DEV_VITE_PORT} (PID ${DEV_VITE_PID})"

  # Brief check that Vite didn't crash immediately
  sleep 1
  if ! pid_alive "$DEV_VITE_PID"; then
    echo "Warning: Vite server exited immediately." >&2
    report_log "$(log_dir)/vite.log"
  fi

  save_state

  echo ""
  echo "Dev environment ready (suffix: ${SUFFIX}):"
  if [ "$OPT_NO_DB" != "1" ]; then
    echo "  db:  postgres://dispatch:dispatch@127.0.0.1:${DEV_DB_PORT}/dispatch_${DEV_CONTAINER_SUFFIX}"
  fi
  echo "  api: http://${DEV_DISPLAY_HOST}:${DEV_API_PORT}"
  echo "  web: http://${DEV_DISPLAY_HOST}:${DEV_VITE_PORT}"
  if [ -n "${DEV_LAN_HOST:-}" ]; then
    echo "  on this network: http://${DEV_LAN_HOST}:${DEV_VITE_PORT}"
    echo "  (reachable by anything on the network — set a password in Settings)"
  fi
  echo "  release cache: ${DEV_RELEASE_CACHE_DIR}"
  echo ""
  echo "Cleanup: dispatch-dev down${OPT_SUFFIX:+ --suffix $SUFFIX}"
}

# Stop every agent host this stack spawned. They outlive the API server by
# design, so stopping the server alone would leave engines running.
stop_agent_hosts() {
  local root="$(log_dir)/agents"
  [ -d "$root" ] || return 0
  local pidfile pid
  for pidfile in "$root"/*/host.pid; do
    [ -f "$pidfile" ] || continue
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    [ -n "$pid" ] || continue
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  done
}

cmd_down() {
  if ! load_state; then
    echo "No state file found for suffix '${SUFFIX}'. Nothing to tear down."
    return 0
  fi

  stop_agent_hosts
  stop_service "${DEV_API_PID:-}" "API server"
  stop_service "${DEV_VITE_PID:-}" "Vite server"

  # The container goes; its data stays on the stack's named volume and is
  # mounted again by the next `up`. Agent hosts always stop with the stack;
  # `--wipe` additionally removes the persisted database data.
  if [ -n "${DEV_COMPOSE_PROJECT:-}" ] && [ "${DEV_NO_DB:-0}" != "1" ]; then
    local compose
    compose="$(detect_compose)"
    if [ -n "$compose" ]; then
      if [ "$OPT_WIPE" = "1" ]; then
        $compose -f "${SCRIPT_DIR}/docker-compose.yml" -p "$DEV_COMPOSE_PROJECT" down -v 2>/dev/null || true
        echo "Removed database container and its data"
      else
        $compose -f "${SCRIPT_DIR}/docker-compose.yml" -p "$DEV_COMPOSE_PROJECT" down 2>/dev/null || true
        echo "Stopped database container (data kept; --wipe to delete it)"
      fi
    fi
  fi

  rm -f "$(state_file)"
  # Logs and the agent state root are the stack's scratch space, not its
  # data; they are only worth keeping while the data is.
  if [ "$OPT_WIPE" = "1" ]; then
    rm -rf "$(log_dir)"
  fi

  echo "Dev environment torn down (suffix: ${SUFFIX})."
}

# Returns 0 when the postgres container for the loaded state is
# running and healthy. Caller is expected to have invoked load_state.
db_container_running() {
  if [ "${DEV_NO_DB:-0}" = "1" ] || [ -z "${DEV_CONTAINER_SUFFIX:-}" ]; then
    return 1
  fi
  local container_name="dispatch-postgres-${DEV_CONTAINER_SUFFIX}"
  docker ps -q -f "name=${container_name}" 2>/dev/null | grep -q .
}

# Soft restart: cycle API + Vite while leaving the DB container running.
# Falls back to a full teardown + cmd_up if there's no usable state or
# the DB isn't actually running.
cmd_restart() {
  if ! load_state 2>/dev/null; then
    echo "No state file found for suffix '${SUFFIX}'. Falling back to a fresh up."
    cmd_up
    return
  fi

  # Restore the persisted host policy before any restart path can tear down
  # the current stack. Later callers (including the repo dev restart tool)
  # inherit the long-lived stack's original opt-in from state.
  [ "$OPT_PRESERVE_AGENT_HOSTS" = "0" ] && [ "${DEV_PRESERVE_AGENT_HOSTS:-0}" = "1" ] && OPT_PRESERVE_AGENT_HOSTS="1"

  if [ "${DEV_NO_DB:-0}" != "1" ] && ! db_container_running; then
    if [ "$OPT_PRESERVE_AGENT_HOSTS" = "1" ]; then
      # cmd_up below recreates the DB container from its retained volume.
      # Do not call cmd_down: it intentionally stops every agent host, even
      # though the missing database does not require touching those processes.
      echo "DB container is gone — recreating it without stopping agent hosts."
    else
      echo "DB container is gone — starting it again; its data is on the volume."
      cmd_down 2>/dev/null || true
      # The volume survived the container, so the data is already there and
      # seeding it again would collide with the rows it produced last time.
      OPT_NO_SEED="1"
      cmd_up
      return
    fi
  fi

  # Stop the app processes only — DB stays up. Hosts get their own process
  # groups, so stop them explicitly unless this stack opted into preserving
  # them; kill_tree's exclusion then protects the preserved host subtree.
  if [ "$OPT_PRESERVE_AGENT_HOSTS" != "1" ]; then
    stop_agent_hosts
  fi
  stop_service "${DEV_API_PID:-}" "API server" "$OPT_PRESERVE_AGENT_HOSTS"
  stop_service "${DEV_VITE_PID:-}" "Vite server" "$OPT_PRESERVE_AGENT_HOSTS"

  # Re-launch on the same ports so any open browser tabs reconnect
  # without a manual refresh, and so the DATABASE_URL we assemble
  # below still points at the running container.
  RESTART_DB_PORT="${DEV_DB_PORT:-}"
  RESTART_API_PORT="${DEV_API_PORT:-}"
  RESTART_VITE_PORT="${DEV_VITE_PORT:-}"

  # Restore the OPT_* flags from saved state so cmd_up branches
  # consistently with the previous run.
  [ "$OPT_LIVE" = "0" ] && [ "${DEV_LIVE:-0}" = "1" ] && OPT_LIVE="1"
  [ "$OPT_NO_DB" = "0" ] && [ "${DEV_NO_DB:-0}" = "1" ] && OPT_NO_DB="1"
  [ -z "$OPT_CWD" ] && [ -n "${DEV_CWD:-}" ] && OPT_CWD="$DEV_CWD"

  # Always skip seeding on restart — the DB already has the data the
  # last seed produced, and re-running would either duplicate rows or
  # crash on existing-row constraints.
  OPT_NO_SEED="1"

  # Move the state file aside (instead of deleting it) so that if
  # cmd_up fails — port conflict, runtime crash, missing dep — the
  # caller can still `dispatch-dev down` and find the still-running
  # postgres container. cmd_up writes a fresh state on success; on
  # failure the EXIT trap restores the backup.
  local sf="$(state_file)"
  local sf_backup="${sf}.restart-backup"
  mv "$sf" "$sf_backup"

  # `set -e` will abort the function on cmd_up failure, so the trap
  # is the only place the backup gets restored on error. On success
  # we clear the trap and remove the backup explicitly.
  # shellcheck disable=SC2064
  trap "
    if [ -f \"$sf_backup\" ] && [ ! -f \"$sf\" ]; then
      mv \"$sf_backup\" \"$sf\"
      echo 'Restart aborted; restored prior state file so dispatch-dev down can clean up.' >&2
    fi
  " EXIT

  cmd_up

  rm -f "$sf_backup"
  trap - EXIT
}

cmd_status() {
  if ! load_state; then
    echo "No dev environment found for suffix '${SUFFIX}'."
    return 0
  fi

  # DB
  if [ "${DEV_NO_DB:-0}" != "1" ] && [ -n "${DEV_CONTAINER_SUFFIX:-}" ]; then
    local container_name="dispatch-postgres-${DEV_CONTAINER_SUFFIX}"
    if docker ps -q -f "name=${container_name}" 2>/dev/null | grep -q .; then
      echo "db:   running (port ${DEV_DB_PORT:-?})"
    else
      echo "db:   stopped"
    fi
  else
    echo "db:   not managed"
  fi

  # API
  if pid_alive "${DEV_API_PID:-}"; then
    echo "api:  running — http://${DEV_DISPLAY_HOST:-127.0.0.1}:${DEV_API_PORT}"
  else
    echo "api:  stopped"
  fi

  # Vite
  if pid_alive "${DEV_VITE_PID:-}"; then
    echo "vite: running — http://${DEV_DISPLAY_HOST:-127.0.0.1}:${DEV_VITE_PORT}"
    [ -n "${DEV_LAN_HOST:-}" ] &&
      echo "      on this network — http://${DEV_LAN_HOST}:${DEV_VITE_PORT}"
  else
    if [ -n "${DEV_VITE_PID:-}" ]; then
      echo "vite: stopped"
    else
      echo "vite: not started"
    fi
  fi

  if [ -n "${DEV_RELEASE_CACHE_DIR:-}" ]; then
    echo "release cache: ${DEV_RELEASE_CACHE_DIR}"
  fi
}

cmd_url() {
  if ! load_state; then
    echo "No dev environment found for suffix '${SUFFIX}'." >&2
    exit 1
  fi
  if [ -z "${DEV_API_PORT:-}" ]; then
    echo "Dev server is not running." >&2
    exit 1
  fi
  echo "http://${DEV_DISPLAY_HOST:-127.0.0.1}:${DEV_API_PORT}"
}

cmd_logs() {
  local logdir
  logdir="$(log_dir)"

  if [ "$OPT_LOG_DB" = "1" ]; then
    if ! load_state; then
      echo "No dev environment found." >&2
      exit 1
    fi
    if [ -n "${DEV_COMPOSE_PROJECT:-}" ]; then
      local compose
      compose="$(detect_compose)"
      $compose -f "${SCRIPT_DIR}/docker-compose.yml" -p "$DEV_COMPOSE_PROJECT" logs --tail 100 2>&1
    else
      echo "No managed database found." >&2
      exit 1
    fi
    return
  fi

  local logfile
  if [ "$OPT_LOG_VITE" = "1" ]; then
    logfile="${logdir}/vite.log"
  else
    logfile="${logdir}/api.log"
  fi

  if [ ! -f "$logfile" ]; then
    echo "No log file found at ${logfile}" >&2
    exit 1
  fi

  if [ "$OPT_FOLLOW" = "1" ]; then
    tail -n 200 -f "$logfile"
  else
    tail -n 200 "$logfile"
  fi
}

# ---------------------------------------------------------------------------
# Parse args
# ---------------------------------------------------------------------------

OPT_CWD=""
OPT_NO_DB="0"
OPT_LIVE="0"
OPT_NO_SEED="0"
OPT_PRESERVE_AGENT_HOSTS="0"
OPT_SUFFIX=""
OPT_WIPE="0"
OPT_LOG_DB="0"
OPT_LOG_VITE="0"
OPT_FOLLOW="0"
CMD=""

while [ $# -gt 0 ]; do
  case "$1" in
    up|down|restart|status|logs|url)
      CMD="$1"; shift ;;
    start) CMD="up"; shift ;;
    stop)  CMD="down"; shift ;;
    --cwd)
      OPT_CWD="${2:-}"; shift 2 ;;
    --no-db)
      OPT_NO_DB="1"; shift ;;
    --live)
      OPT_LIVE="1"; shift ;;
    --no-seed)
      OPT_NO_SEED="1"; shift ;;
    --preserve-agent-hosts)
      OPT_PRESERVE_AGENT_HOSTS="1"; shift ;;
    --wipe)
      OPT_WIPE="1"; shift ;;
    --suffix)
      OPT_SUFFIX="${2:-}"; shift 2 ;;
    --db)
      OPT_LOG_DB="1"; shift ;;
    --vite)
      OPT_LOG_VITE="1"; shift ;;
    -f|--follow)
      OPT_FOLLOW="1"; shift ;;
    -h|--help)
      usage; exit 0 ;;
    *)
      echo "Unknown argument: $1" >&2
      usage; exit 1 ;;
  esac
done

if [ -z "$CMD" ]; then
  usage
  exit 1
fi

SUFFIX="$(resolve_suffix)"

case "$CMD" in
  up)       cmd_up ;;
  down)     cmd_down ;;
  restart)  cmd_restart ;;
  status)   cmd_status ;;
  logs)     cmd_logs ;;
  url)      cmd_url ;;
  *)        usage; exit 1 ;;
esac
