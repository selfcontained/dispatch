#!/usr/bin/env bash
set -euo pipefail

# dispatch-dev — standalone dev-stack helper.
#
# Starts an isolated Postgres DB, API server, and Vite frontend on
# auto-selected free ports. State is persisted to /tmp so that down/status/
# logs/url can find the running stack later.
#
# No tmux or agent-session dependency — just background processes + PID files.
#
# The Dispatch MCP repo_dev_* tools (repo_dev_up, repo_dev_restart, etc.) run
# the copy of this script that lives in the calling agent's own working
# directory (its install), passing the repo under test with --cwd. A change
# made here is not exercised by those tools until it is installed there, so
# validate script changes directly: run ./bin/dispatch-dev from this worktree
# with --suffix so it does not collide with any stack already running.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Preflight — fail fast if required tools are missing.
if ! command -v node &>/dev/null; then
  echo "Error: node is not available. Install Node.js first." >&2
  exit 1
fi

usage() {
  cat <<'USAGE'
Usage: dispatch-dev <command> [options]

Start an isolated dev environment with its own DB, API server, and
Vite frontend — all on auto-selected free ports.

Commands:
  up        Start DB + API server + Vite frontend
  down      Stop all dev services and remove the DB container
  restart   Restart the API + Vite servers, keeping the DB intact
  status    Show which services are running
  logs      Show recent output (default: api; use --vite or --db)
  url       Print the dev server URL

Options:
  --cwd <path>      Working directory (default: current directory)
  --no-db           Skip database (use existing DATABASE_URL)
  --suffix <name>   Explicit stack suffix (default: agent ID or generated)
  --live            Enable live agent runtime (tmux); default is inert.
                    Also disables the default dev-data seed.
  --no-seed         Skip seeding demo data (seed is on by default for non-live)
  -f, --follow      Follow log output (used with logs command)
USAGE
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Grab a free port from the OS. Small TOCTOU window between closing the probe
# socket and the actual service binding, but acceptable for dev tooling.
find_free_port() {
  node -e '
    const net = require("net");
    const srv = net.createServer();
    srv.listen(0, "127.0.0.1", () => {
      console.log(srv.address().port);
      srv.close();
    });
  '
}


resolve_suffix() {
  if [ -n "$OPT_SUFFIX" ]; then
    echo "$OPT_SUFFIX"
  elif [ -n "${DISPATCH_AGENT_ID:-}" ]; then
    echo "$DISPATCH_AGENT_ID"
  else
    echo "dev-$$-$(date +%s)"
  fi
}

state_file() {
  echo "/tmp/dispatch-dev-${SUFFIX}.env"
}

log_dir() {
  echo "/tmp/dispatch-dev-${SUFFIX}"
}

release_cache_dir() {
  echo "${DEV_CWD}/.dispatch/dev-cache/release-${SUFFIX}"
}

save_state() {
  cat > "$(state_file)" <<EOF
DEV_SUFFIX=${SUFFIX}
DEV_CWD=${DEV_CWD:-}
DEV_DB_PORT=${DEV_DB_PORT:-}
DEV_API_PORT=${DEV_API_PORT:-}
DEV_API_PID=${DEV_API_PID:-}
DEV_VITE_PORT=${DEV_VITE_PORT:-}
DEV_VITE_PID=${DEV_VITE_PID:-}
DEV_CONTAINER_SUFFIX=${DEV_CONTAINER_SUFFIX:-}
DEV_COMPOSE_PROJECT=${DEV_COMPOSE_PROJECT:-}
DEV_NO_DB=${DEV_NO_DB:-0}
DEV_LIVE=${OPT_LIVE:-0}
DEV_NO_SEED=${OPT_NO_SEED:-0}
DEV_DISPLAY_HOST=${DEV_DISPLAY_HOST:-127.0.0.1}
DEV_RELEASE_CACHE_DIR=${DEV_RELEASE_CACHE_DIR:-}
EOF
}

load_state() {
  local file
  file="$(state_file)"
  if [ -f "$file" ]; then
    # shellcheck disable=SC1090
    source "$file"
    return 0
  fi
  return 1
}

pid_alive() {
  [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

# Recursively kill a process and all its descendants (depth-first).
# This ensures child processes spawned by npm/tsx are cleaned up even
# when signals don't propagate through the wrapper chain.
kill_tree() {
  local pid="${1:-}"
  local sig="${2:-TERM}"
  [ -z "$pid" ] && return 0
  local children
  children=$(pgrep -P "$pid" 2>/dev/null) || true
  for child in $children; do
    kill_tree "$child" "$sig"
  done
  kill -"$sig" "$pid" 2>/dev/null || true
}

# The PID holding the listening socket on a TCP port, or empty.
#
# The recorded PID for each dev service is a `pnpm` wrapper, not the server:
# `pnpm run dev` execs node, which spawns a shell, which spawns pnpm again,
# which finally spawns `bun --watch src/main.ts` (the process that binds the
# port and parents the harness engine children). pnpm does not forward
# SIGTERM, so the kernel's own answer to "who owns the port" is the only
# reliable way to reach the server.
port_listener_pid() {
  local port="${1:-}"
  [ -z "$port" ] && return 0
  local pid=""
  if command -v ss &>/dev/null; then
    pid="$(ss -ltnpH "sport = :${port}" 2>/dev/null |
      grep -oE 'pid=[0-9]+' | head -n 1 | cut -d= -f2 || true)"
  fi
  if [ -z "$pid" ] && command -v lsof &>/dev/null; then
    pid="$(lsof -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | head -n 1 || true)"
  fi
  # Empty is a legitimate answer (nothing is listening), but it is also what
  # a missing tool or a permission-denied lookup returns, and callers cannot
  # tell those apart from the PID alone. Re-run both lookups raw so an empty
  # result explains itself in the log instead of reading as "port is free."
  if [ -z "$pid" ]; then
    echo "port_listener_pid: no owner found for port ${port}; raw lookups follow" >&2
    if command -v ss &>/dev/null; then
      echo "  ss:   $(ss -ltnpH "sport = :${port}" 2>&1 || true)" >&2
    else
      echo "  ss:   not installed" >&2
    fi
    if command -v lsof &>/dev/null; then
      echo "  lsof: $(lsof -iTCP:"$port" -sTCP:LISTEN 2>&1 || true)" >&2
    else
      echo "  lsof: not installed" >&2
    fi
  fi
  echo "$pid"
}

# True when `needle` is `root` or one of its descendants.
#
# root == "1" (init/the subreaper) can never match here: the loop condition
# stops the walk as soon as p reaches "1", before the `[ "$p" = "$root" ]`
# comparison runs for that value. That's fine because no caller passes 1:
# it would mean "anything reparented to init counts," which is not a check
# any caller wants, so this is a dead branch by design, not a bug to fix.
pid_in_tree() {
  local needle="${1:-}"
  local root="${2:-}"
  [ -z "$needle" ] && return 1
  [ -z "$root" ] && return 1
  local p="$needle"
  local hops=0
  while [ -n "$p" ] && [ "$p" != "1" ] && [ $hops -lt 20 ]; do
    [ "$p" = "$root" ] && return 0
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ' || true)"
    hops=$((hops + 1))
  done
  return 1
}

# Stop a dev service: the process that owns the port first, then its
# wrappers, then force.
#
# The server is signaled directly, which is what the production unit does
# (KillMode=process): its own shutdown handler runs, and a harness agent's
# engine child gets the close-session teardown that marks the running turn
# as cut by the restart. Its children are never signaled from here, because
# killing an engine out from under the server leaves the agent needing a
# manual Start. The wrapper chain goes next so no pnpm or shell lingers,
# and the depth-first SIGKILL sweep stays the escape hatch for anything
# that ignores all of it.
#
# The fourth argument is how long the server may take over that shutdown.
# It has to cover what `cleanupAppResources` waits for before the engine
# children are even reached: active archives (10 s), in-flight chat
# deliveries (5 s, and a queued message counts), then the supervisor's
# reconcile (2 s) and stop (5 s) bounds, inside which each child walks a
# 3 x 1.5 s teardown ladder. A window shorter than that hands a live turn
# to the SIGKILL sweep mid-shutdown, which is the very thing signaling the
# server first is meant to avoid, so the API gets 30 s. Vite has no such
# shutdown and keeps 5.
stop_service() {
  local pid="${1:-}"
  local name="${2:-service}"
  local port="${3:-}"
  local grace="${4:-5}"
  local listener
  listener="$(port_listener_pid "$port")"
  if [ -n "$listener" ] && ! pid_alive "$listener"; then
    listener=""
  fi
  if ! pid_alive "$pid" && [ -z "$listener" ]; then
    return 0
  fi

  # Confirm the port's owner is actually this stack before touching it. A
  # stale state file whose port has since been recycled would otherwise get
  # another agent's dev server signaled here, since every agent runs its own
  # stack and ports are auto-selected from the same range.
  if [ -n "$listener" ]; then
    local listener_belongs=0
    if pid_alive "$pid"; then
      # The wrapper is alive, so the tree walk is meaningful: the listener
      # must be the wrapper itself or one of its descendants.
      if pid_in_tree "$listener" "$pid"; then
        listener_belongs=1
      fi
    else
      # The wrapper is already gone, so there is no tree left to walk. Fall
      # back to comparing the listener's cwd against this stack's directory.
      local listener_cwd stack_cwd
      listener_cwd="$(readlink "/proc/${listener}/cwd" 2>/dev/null || true)"
      stack_cwd="$(readlink -f "${DEV_CWD:-}" 2>/dev/null || true)"
      if [ -n "$listener_cwd" ] && [ -n "$stack_cwd" ] && [ "$listener_cwd" = "$stack_cwd" ]; then
        listener_belongs=1
      fi
    fi
    if [ "$listener_belongs" != "1" ]; then
      echo "port ${port} is held by PID ${listener}, which is not part of this stack; refusing to stop it" >&2
      return 1
    fi
  fi

  if [ -n "$listener" ]; then
    kill -TERM "$listener" 2>/dev/null || true
    local ticks=$((grace * 2))
    local waited=0
    local noted=0
    while [ $waited -lt $ticks ] && pid_alive "$listener"; do
      sleep 0.5
      waited=$((waited + 1))
      # Past five seconds this looks like a hang; say what it is waiting on.
      if [ $noted -eq 0 ] && [ $waited -ge 10 ]; then
        noted=1
        echo "Waiting for the ${name} to finish its shutdown (up to ${grace}s)..."
      fi
    done
  fi

  if pid_alive "$pid"; then
    kill_tree "$pid"
    local i=0
    while [ $i -lt 10 ] && pid_alive "$pid"; do
      sleep 0.5
      i=$((i + 1))
    done
  fi

  if pid_alive "$pid"; then
    kill_tree "$pid" 9
  fi
  if [ -n "$listener" ] && pid_alive "$listener"; then
    kill -KILL "$listener" 2>/dev/null || true
  fi
  echo "Stopped ${name} (PID ${pid}${listener:+, server ${listener}})"
}

# Detect docker compose command
detect_compose() {
  if docker compose version &>/dev/null; then
    echo "docker compose"
  elif command -v docker-compose &>/dev/null; then
    echo "docker-compose"
  else
    echo ""
  fi
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_up() {
  local cwd="${OPT_CWD:-$(pwd)}"

  # Check for existing live stack
  if [ -f "$(state_file)" ]; then
    load_state
    if pid_alive "${DEV_API_PID:-}"; then
      echo "Stack '${SUFFIX}' is already running (API PID ${DEV_API_PID}, port ${DEV_API_PORT})."
      echo "Run 'dispatch-dev down' first, or use a different --suffix."
      exit 1
    fi
    # Stale state — clean it up
    echo "Cleaning stale state for '${SUFFIX}'..."
    cmd_down 2>/dev/null || true
  fi

  mkdir -p "$(log_dir)"
  DEV_CWD="$cwd"
  DEV_RELEASE_CACHE_DIR="$(release_cache_dir)"

  # --- Database ---
  DEV_NO_DB="$OPT_NO_DB"
  if [ "$OPT_NO_DB" != "1" ]; then
    local compose
    compose="$(detect_compose)"
    if [ -z "$compose" ]; then
      echo "Error: docker compose is not available. Is Docker Desktop running?" >&2
      exit 1
    fi

    DEV_CONTAINER_SUFFIX="$SUFFIX"
    DEV_COMPOSE_PROJECT="dispatch-dev-${SUFFIX}"

    local db_attempt=1
    local db_max_attempts=5
    local compose_output
    compose_output="$(log_dir)/db-up.log"
    while [ $db_attempt -le $db_max_attempts ]; do
      DEV_DB_PORT="${RESTART_DB_PORT:-$(find_free_port)}"

      echo "Starting database on port ${DEV_DB_PORT}..."

      if DISPATCH_DB_NAME="$DEV_CONTAINER_SUFFIX" DISPATCH_DB_PORT="$DEV_DB_PORT" \
        $compose -f "${SCRIPT_DIR}/docker-compose.yml" -p "$DEV_COMPOSE_PROJECT" up -d --wait >"$compose_output" 2>&1; then
        cat "$compose_output"
        echo "Database ready on port ${DEV_DB_PORT}"
        break
      fi

      cat "$compose_output"
      if [ -n "${RESTART_DB_PORT:-}" ] || ! grep -q "address already in use" "$compose_output" || [ $db_attempt -eq $db_max_attempts ]; then
        exit 1
      fi

      echo "Database port ${DEV_DB_PORT} was claimed before Docker could bind it; retrying..." >&2
      $compose -f "${SCRIPT_DIR}/docker-compose.yml" -p "$DEV_COMPOSE_PROJECT" down -v >/dev/null 2>&1 || true
      db_attempt=$((db_attempt + 1))
    done
  fi

  # --- API Server ---
  DEV_API_PORT="${RESTART_API_PORT:-$(find_free_port)}"
  DEV_DISPLAY_HOST="${DISPATCH_HOST:-127.0.0.1}"

  # Build environment
  (

    cd "$cwd"

    # Source .env if present
    if [ -f ".env" ]; then
      set -a
      # shellcheck disable=SC1091
      source ".env"
      set +a
    fi

    # Unset TLS so dev servers run plain HTTP
    unset TLS_CERT TLS_KEY 2>/dev/null || true

    # Override port, session prefix, and agent runtime — always explicit so .env doesn't leak
    export DISPATCH_PORT="$DEV_API_PORT"
    export DISPATCH_SESSION_PREFIX="dispatch_dev"
    if [ "$OPT_LIVE" = "1" ]; then
      export DISPATCH_AGENT_RUNTIME="tmux"
    else
      export DISPATCH_AGENT_RUNTIME="inert"
    fi

    # Keep the release store out of ~/.dispatch/ — a stale version there
    # surfaces the update-available toast against the dev build.
    export DISPATCH_RELEASE_STORE_PATH="$(log_dir)/release.json"
    export DISPATCH_RELEASE_CANDIDATE_STORE_PATH="$(log_dir)/release-candidate.json"
    export DISPATCH_RELEASE_CACHE_DIR="$DEV_RELEASE_CACHE_DIR"

    if [ "$OPT_NO_DB" != "1" ]; then
      export DATABASE_URL="postgres://dispatch:dispatch@127.0.0.1:${DEV_DB_PORT}/dispatch_${DEV_CONTAINER_SUFFIX}"
    fi

    pnpm run dev >> "$(log_dir)/api.log" 2>&1 &
    echo $! > "$(log_dir)/api.pid"
  )

  DEV_API_PID="$(cat "$(log_dir)/api.pid")"
  echo "API server starting on port ${DEV_API_PORT} (PID ${DEV_API_PID})"

  # Liveness check — wait up to 10s for the port, then verify /health
  local attempts=0
  local port_open=0
  while [ $attempts -lt 20 ]; do
    if ! pid_alive "$DEV_API_PID"; then
      echo "Error: API server exited immediately. Last log lines:" >&2
      tail -n 20 "$(log_dir)/api.log" 2>/dev/null >&2 || true
      exit 1
    fi
    if node -e "const s=require('net').createConnection({host:'127.0.0.1',port:${DEV_API_PORT}},()=>{s.end();process.exit(0)});s.on('error',()=>process.exit(1))" 2>/dev/null; then
      port_open=1
      break
    fi
    attempts=$((attempts + 1))
    sleep 0.5
  done

  # The wrapper stayed alive for the whole wait but the port never opened.
  # Don't fall through to seeding, Vite, and save_state as if this were a
  # working stack. Fail now, while the log lines below still explain why.
  if [ "$port_open" != "1" ]; then
    echo "Error: API server did not open port ${DEV_API_PORT} within 10s. Last log lines:" >&2
    tail -n 20 "$(log_dir)/api.log" 2>/dev/null >&2 || true
    exit 1
  fi

  # An open port is not proof the server we just started owns it. A restart
  # reuses the port, so a listener from outside this tree means the old
  # server never died: the health check below would pass against stale code
  # and the restart would report success. Fail loudly instead.
  #
  # A listener reparented to a subreaper also fails this check: if the
  # middle wrapper in the pnpm chain dies right after launch, the kernel
  # re-parents the surviving bun process, and pid_in_tree can no longer walk
  # from it back up to DEV_API_PID. That misnames the culprit, blaming a
  # nonexistent "earlier dev server" when the process is actually the one
  # just started, but it still fails loudly and a retry (`up` again) fixes
  # it, which is the direction this check should err in.
  if [ "$port_open" = "1" ]; then
    local api_listener
    api_listener="$(port_listener_pid "$DEV_API_PORT")"
    if [ -n "$api_listener" ] && ! pid_in_tree "$api_listener" "$DEV_API_PID"; then
      echo "Error: port ${DEV_API_PORT} is held by PID ${api_listener}, which is not part of the API server just started (PID ${DEV_API_PID})." >&2
      echo "An earlier dev server still owns the port, so this stack would serve stale code. Stop it and retry: kill ${api_listener}" >&2
      exit 1
    fi
  fi

  # Verify the API is actually healthy, not just listening
  if [ "$port_open" = "1" ]; then
    local health_attempts=0
    while [ $health_attempts -lt 10 ]; do
      if curl -fsS -m 2 "http://127.0.0.1:${DEV_API_PORT}/api/v1/health" >/dev/null 2>&1; then
        break
      fi
      if ! pid_alive "$DEV_API_PID"; then
        echo "Error: API server crashed during startup. Last log lines:" >&2
        tail -n 20 "$(log_dir)/api.log" 2>/dev/null >&2 || true
        exit 1
      fi
      health_attempts=$((health_attempts + 1))
      sleep 1
    done
  fi

  # --- Seed demo data (dev-only, explicit) ---
  # Runs after the API is up so the UI has something to render on first load.
  # Not invoked by the server runtime — this is the only code path that seeds.
  # --live and --no-seed both skip it.
  if [ "$OPT_LIVE" != "1" ] && [ "$OPT_NO_SEED" != "1" ] && [ "$OPT_NO_DB" != "1" ]; then
    echo "Seeding demo data..."
    (
      cd "$cwd"
      export DATABASE_URL="postgres://dispatch:dispatch@127.0.0.1:${DEV_DB_PORT}/dispatch_${DEV_CONTAINER_SUFFIX}"
      pnpm --filter @dispatch/server exec tsx src/db/seed/run.ts >> "$(log_dir)/seed.log" 2>&1
    ) || {
      echo "Warning: seed failed. See $(log_dir)/seed.log for details." >&2
    }
  fi

  # --- Vite Frontend ---
  DEV_VITE_PORT="${RESTART_VITE_PORT:-$(find_free_port)}"
  local vite_cache_dir
  vite_cache_dir="$(log_dir)/vite-cache"

  # Keep each dev stack's Vite optimizer cache isolated so concurrent builds,
  # tests, and other live stacks in the same worktree cannot corrupt it.
  rm -rf "$vite_cache_dir" 2>/dev/null || true

  # Build the downloadable browser extension archive before Vite starts. The
  # web production build copies the same archive into its dist output.
  (
    cd "$cwd"
    pnpm --filter @dispatch/browser-extension package >> "$(log_dir)/vite.log" 2>&1
  )

  (
    cd "${cwd}/apps/web"
    # Tell Vite's proxy where the API server is
    env \
      DISPATCH_PORT="$DEV_API_PORT" \
      DISPATCH_VITE_CACHE_DIR="$vite_cache_dir" \
      pnpm exec vite --port "$DEV_VITE_PORT" >> "$(log_dir)/vite.log" 2>&1 &
    echo $! > "$(log_dir)/vite.pid"
  )

  DEV_VITE_PID="$(cat "$(log_dir)/vite.pid")"
  echo "Vite dev server starting on port ${DEV_VITE_PORT} (PID ${DEV_VITE_PID})"

  # Brief check that Vite didn't crash immediately
  sleep 1
  if ! pid_alive "$DEV_VITE_PID"; then
    echo "Warning: Vite server exited immediately. Check $(log_dir)/vite.log" >&2
  fi

  # Same honesty check as the API's: on a restart the port is reused, and a
  # listener from outside this tree is the previous Vite still serving.
  local vite_listener
  vite_listener="$(port_listener_pid "$DEV_VITE_PORT")"
  if [ -n "$vite_listener" ] && ! pid_in_tree "$vite_listener" "$DEV_VITE_PID"; then
    echo "Error: port ${DEV_VITE_PORT} is held by PID ${vite_listener}, which is not part of the Vite server just started (PID ${DEV_VITE_PID})." >&2
    echo "An earlier dev server still owns the port. Stop it and retry: kill ${vite_listener}" >&2
    exit 1
  fi

  save_state

  echo ""
  echo "Dev environment ready (suffix: ${SUFFIX}):"
  if [ "$OPT_NO_DB" != "1" ]; then
    echo "  db:  postgres://dispatch:dispatch@127.0.0.1:${DEV_DB_PORT}/dispatch_${DEV_CONTAINER_SUFFIX}"
  fi
  echo "  api: http://${DEV_DISPLAY_HOST}:${DEV_API_PORT}"
  echo "  web: http://${DEV_DISPLAY_HOST}:${DEV_VITE_PORT}"
  echo "  release cache: ${DEV_RELEASE_CACHE_DIR}"
  echo ""
  echo "Cleanup: dispatch-dev down${OPT_SUFFIX:+ --suffix $SUFFIX}"
}

cmd_down() {
  if ! load_state; then
    echo "No state file found for suffix '${SUFFIX}'. Nothing to tear down."
    return 0
  fi

  stop_service "${DEV_API_PID:-}" "API server" "${DEV_API_PORT:-}" 30
  stop_service "${DEV_VITE_PID:-}" "Vite server" "${DEV_VITE_PORT:-}" 5

  # Stop the DB container
  if [ -n "${DEV_COMPOSE_PROJECT:-}" ] && [ "${DEV_NO_DB:-0}" != "1" ]; then
    local compose
    compose="$(detect_compose)"
    if [ -n "$compose" ]; then
      $compose -f "${SCRIPT_DIR}/docker-compose.yml" -p "$DEV_COMPOSE_PROJECT" down -v 2>/dev/null || true
      echo "Removed database container"
    fi
  fi

  # Clean up state and logs
  rm -f "$(state_file)"
  rm -rf "$(log_dir)"

  echo "Dev environment torn down (suffix: ${SUFFIX})."
}

# Returns 0 when the postgres container for the loaded state is
# running and healthy. Caller is expected to have invoked load_state.
db_container_running() {
  if [ "${DEV_NO_DB:-0}" = "1" ] || [ -z "${DEV_CONTAINER_SUFFIX:-}" ]; then
    return 1
  fi
  local container_name="dispatch-postgres-${DEV_CONTAINER_SUFFIX}"
  docker ps -q -f "name=${container_name}" 2>/dev/null | grep -q .
}

# Soft restart: cycle API + Vite while leaving the DB container running.
# Falls back to a full teardown + cmd_up if there's no usable state or
# the DB isn't actually running.
cmd_restart() {
  if ! load_state 2>/dev/null; then
    echo "No state file found for suffix '${SUFFIX}'. Falling back to a fresh up."
    cmd_up
    return
  fi
  if [ "${DEV_NO_DB:-0}" != "1" ] && ! db_container_running; then
    echo "DB container is gone — falling back to a fresh up (this will reseed)."
    cmd_down 2>/dev/null || true
    cmd_up
    return
  fi

  # Stop the app processes only — DB stays up.
  stop_service "${DEV_API_PID:-}" "API server" "${DEV_API_PORT:-}" 30
  stop_service "${DEV_VITE_PID:-}" "Vite server" "${DEV_VITE_PORT:-}" 5

  # Re-launch on the same ports so any open browser tabs reconnect
  # without a manual refresh, and so the DATABASE_URL we assemble
  # below still points at the running container.
  RESTART_DB_PORT="${DEV_DB_PORT:-}"
  RESTART_API_PORT="${DEV_API_PORT:-}"
  RESTART_VITE_PORT="${DEV_VITE_PORT:-}"

  # Restore the OPT_* flags from saved state so cmd_up branches
  # consistently with the previous run.
  [ "$OPT_LIVE" = "0" ] && [ "${DEV_LIVE:-0}" = "1" ] && OPT_LIVE="1"
  [ "$OPT_NO_DB" = "0" ] && [ "${DEV_NO_DB:-0}" = "1" ] && OPT_NO_DB="1"
  [ -z "$OPT_CWD" ] && [ -n "${DEV_CWD:-}" ] && OPT_CWD="$DEV_CWD"

  # Always skip seeding on restart — the DB already has the data the
  # last seed produced, and re-running would either duplicate rows or
  # crash on existing-row constraints.
  OPT_NO_SEED="1"

  # Move the state file aside (instead of deleting it) so that if
  # cmd_up fails — port conflict, runtime crash, missing dep — the
  # caller can still `dispatch-dev down` and find the still-running
  # postgres container. cmd_up writes a fresh state on success; on
  # failure the EXIT trap restores the backup.
  local sf="$(state_file)"
  local sf_backup="${sf}.restart-backup"
  mv "$sf" "$sf_backup"

  # `set -e` will abort the function on cmd_up failure, so the trap
  # is the only place the backup gets restored on error. On success
  # we clear the trap and remove the backup explicitly.
  # shellcheck disable=SC2064
  trap "
    if [ -f \"$sf_backup\" ] && [ ! -f \"$sf\" ]; then
      mv \"$sf_backup\" \"$sf\"
      echo 'Restart aborted; restored prior state file so dispatch-dev down can clean up.' >&2
    fi
  " EXIT

  cmd_up

  rm -f "$sf_backup"
  trap - EXIT
}

cmd_status() {
  if ! load_state; then
    echo "No dev environment found for suffix '${SUFFIX}'."
    return 0
  fi

  # DB
  if [ "${DEV_NO_DB:-0}" != "1" ] && [ -n "${DEV_CONTAINER_SUFFIX:-}" ]; then
    local container_name="dispatch-postgres-${DEV_CONTAINER_SUFFIX}"
    if docker ps -q -f "name=${container_name}" 2>/dev/null | grep -q .; then
      echo "db:   running (port ${DEV_DB_PORT:-?})"
    else
      echo "db:   stopped"
    fi
  else
    echo "db:   not managed"
  fi

  # API
  if pid_alive "${DEV_API_PID:-}"; then
    echo "api:  running — http://${DEV_DISPLAY_HOST:-127.0.0.1}:${DEV_API_PORT}"
  else
    echo "api:  stopped"
  fi

  # Vite
  if pid_alive "${DEV_VITE_PID:-}"; then
    echo "vite: running — http://${DEV_DISPLAY_HOST:-127.0.0.1}:${DEV_VITE_PORT}"
  else
    if [ -n "${DEV_VITE_PID:-}" ]; then
      echo "vite: stopped"
    else
      echo "vite: not started"
    fi
  fi

  if [ -n "${DEV_RELEASE_CACHE_DIR:-}" ]; then
    echo "release cache: ${DEV_RELEASE_CACHE_DIR}"
  fi
}

cmd_url() {
  if ! load_state; then
    echo "No dev environment found for suffix '${SUFFIX}'." >&2
    exit 1
  fi
  if [ -z "${DEV_API_PORT:-}" ]; then
    echo "Dev server is not running." >&2
    exit 1
  fi
  echo "http://${DEV_DISPLAY_HOST:-127.0.0.1}:${DEV_API_PORT}"
}

cmd_logs() {
  local logdir
  logdir="$(log_dir)"

  if [ "$OPT_LOG_DB" = "1" ]; then
    if ! load_state; then
      echo "No dev environment found." >&2
      exit 1
    fi
    if [ -n "${DEV_COMPOSE_PROJECT:-}" ]; then
      local compose
      compose="$(detect_compose)"
      $compose -f "${SCRIPT_DIR}/docker-compose.yml" -p "$DEV_COMPOSE_PROJECT" logs --tail 100 2>&1
    else
      echo "No managed database found." >&2
      exit 1
    fi
    return
  fi

  local logfile
  if [ "$OPT_LOG_VITE" = "1" ]; then
    logfile="${logdir}/vite.log"
  else
    logfile="${logdir}/api.log"
  fi

  if [ ! -f "$logfile" ]; then
    echo "No log file found at ${logfile}" >&2
    exit 1
  fi

  if [ "$OPT_FOLLOW" = "1" ]; then
    tail -n 200 -f "$logfile"
  else
    tail -n 200 "$logfile"
  fi
}

# ---------------------------------------------------------------------------
# Parse args
# ---------------------------------------------------------------------------

OPT_CWD=""
OPT_NO_DB="0"
OPT_LIVE="0"
OPT_NO_SEED="0"
OPT_SUFFIX=""
OPT_LOG_DB="0"
OPT_LOG_VITE="0"
OPT_FOLLOW="0"
CMD=""

while [ $# -gt 0 ]; do
  case "$1" in
    up|down|restart|status|logs|url)
      CMD="$1"; shift ;;
    start) CMD="up"; shift ;;
    stop)  CMD="down"; shift ;;
    --cwd)
      OPT_CWD="${2:-}"; shift 2 ;;
    --no-db)
      OPT_NO_DB="1"; shift ;;
    --live)
      OPT_LIVE="1"; shift ;;
    --no-seed)
      OPT_NO_SEED="1"; shift ;;
    --suffix)
      OPT_SUFFIX="${2:-}"; shift 2 ;;
    --db)
      OPT_LOG_DB="1"; shift ;;
    --vite)
      OPT_LOG_VITE="1"; shift ;;
    -f|--follow)
      OPT_FOLLOW="1"; shift ;;
    -h|--help)
      usage; exit 0 ;;
    *)
      echo "Unknown argument: $1" >&2
      usage; exit 1 ;;
  esac
done

if [ -z "$CMD" ]; then
  usage
  exit 1
fi

SUFFIX="$(resolve_suffix)"

case "$CMD" in
  up)       cmd_up ;;
  down)     cmd_down ;;
  restart)  cmd_restart ;;
  status)   cmd_status ;;
  logs)     cmd_logs ;;
  url)      cmd_url ;;
  *)        usage; exit 1 ;;
esac
