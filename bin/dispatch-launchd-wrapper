#!/bin/zsh
#
# Wrapper script for launchd. Sources the user's shell config to ensure
# the full environment (NVM, Homebrew, PATH, API keys, etc.) is available
# to Dispatch and any agents it spawns.
#
# launchd runs with a minimal environment by default - this fixes that.

[[ -f ~/.zprofile ]] && source ~/.zprofile
[[ -f ~/.zshrc ]] && source ~/.zshrc

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
OS_NAME="$(uname -s)"
ARCH_NAME="$(uname -m)"

case "$OS_NAME" in
  Darwin) PLATFORM="darwin" ;;
  Linux) PLATFORM="linux" ;;
  *)
    echo "error: unsupported OS $OS_NAME" >&2
    exit 1
    ;;
esac

case "$ARCH_NAME" in
  arm64|aarch64) ARCH="arm64" ;;
  x86_64) ARCH="x64" ;;
  *)
    echo "error: unsupported architecture $ARCH_NAME" >&2
    exit 1
    ;;
esac

BINARY=$(find "$ROOT_DIR/dist/bun" -maxdepth 1 -type f \
  -name "dispatch-*-bun-${PLATFORM}-${ARCH}" | sort -V | tail -n 1)

if [[ -z "$BINARY" ]]; then
  echo "error: no Dispatch binary found for ${PLATFORM}/${ARCH} in $ROOT_DIR/dist/bun" >&2
  exit 1
fi

cd "$ROOT_DIR"
exec "$BINARY"
