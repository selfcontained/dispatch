#!/bin/zsh
#
# Wrapper script for launchd. Sources the user's shell config to ensure
# the full environment (NVM, Homebrew, PATH, API keys, etc.) is available
# to Dispatch and any agents it spawns.
#
# launchd runs with a minimal environment by default - this fixes that.

[[ -f ~/.zprofile ]] && source ~/.zprofile
[[ -f ~/.zshrc ]] && source ~/.zshrc

export TERM="${TERM:-xterm-256color}"

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
OS_NAME="$(uname -s)"
ARCH_NAME="$(uname -m)"

case "$OS_NAME" in
  Darwin) PLATFORM="darwin" ;;
  Linux) PLATFORM="linux" ;;
  *)
    echo "error: unsupported OS $OS_NAME" >&2
    exit 1
    ;;
esac

case "$ARCH_NAME" in
  arm64|aarch64) ARCH="arm64" ;;
  x86_64) ARCH="x64" ;;
  *)
    echo "error: unsupported architecture $ARCH_NAME" >&2
    exit 1
    ;;
esac

matches=("$ROOT_DIR"/dist/bun/dispatch-*-bun-${PLATFORM}-${ARCH})
if [[ ! -e "${matches[1]}" ]]; then
  echo "error: no Dispatch binary found for ${PLATFORM}/${ARCH} in $ROOT_DIR/dist/bun" >&2
  exit 1
fi

BINARY=$(ls -t "$ROOT_DIR"/dist/bun/dispatch-*-bun-${PLATFORM}-${ARCH} 2>/dev/null | head -n 1)
if [[ -z "$BINARY" ]]; then
  echo "error: failed to select Dispatch binary for ${PLATFORM}/${ARCH}" >&2
  exit 1
fi

cd "$ROOT_DIR"
exec "$BINARY"
