#!/usr/bin/env bash
set -euo pipefail
#
# Packs a release tarball containing the compiled Bun binaries and the helper
# scripts used to install and manage them on a host machine.
#
# Usage: bin/pack-release [--output <path>]
#
# The tarball includes:
#   - Pre-built Bun binaries + checksums
#   - bin/ scripts and docs/configuration needed at runtime
#
# NOT included (must be handled on host):
#   - node_modules/
#   - .env (host-specific configuration)

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUTPUT=""

usage() {
  cat <<USAGE
Usage: bin/pack-release [--output <path>]

Packs a release tarball from the already-built Bun binaries.
Requires that 'pnpm run build:bun' has already been run.

Options:
  --output <path>  Output tarball path (default: dispatch-release.tar.gz in repo root)
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output) OUTPUT="$2"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "error: unknown argument: $1" >&2; usage; exit 1 ;;
  esac
done

OUTPUT="${OUTPUT:-$ROOT_DIR/dispatch-release.tar.gz}"

# Validate that builds exist
missing=()
[[ -d "$ROOT_DIR/dist/bun" ]] || missing+=("dist/bun")

if [[ ${#missing[@]} -gt 0 ]]; then
  echo "error: missing build outputs — run 'pnpm run build:bun' first:" >&2
  printf '  %s\n' "${missing[@]}" >&2
  exit 1
fi

cd "$ROOT_DIR"

# Build the file list for the tarball
# We use a manifest approach so it's easy to see exactly what's included
MANIFEST=$(mktemp)
trap 'rm -f "$MANIFEST"' EXIT

# If you add a new runtime dependency (file, directory, config), add it to
# this manifest AND to the pack-release.test.ts assertions.
cat > "$MANIFEST" <<'LIST'
dist/bun
README.md
.env.example
bin
LIST

# Conditionally include migrations if they exist
if [[ -d "apps/server/src/db/migrations" ]]; then
  echo "apps/server/src/db/migrations" >> "$MANIFEST"
fi

# Conditionally include release notes if they exist
if [[ -f "release-notes/current.md" ]]; then
  echo "release-notes/current.md" >> "$MANIFEST"
fi

# Conditionally include update migrations if any exist. The runtime opens
# the tarball at "Check for Updates" time and extracts only update-migrations/
# to determine whether assisted update is required for the target tag.
if [[ -d "update-migrations" ]]; then
  echo "update-migrations" >> "$MANIFEST"
fi

# BSD tar on macOS otherwise stores Finder/xattr metadata (e.g. the
# com.apple.provenance xattr) as LIBARCHIVE.xattr.*/SCHILY.xattr.* pax headers
# in the tar stream. --no-xattrs stops that (modern bsdtar routes Finder/mac
# metadata through the same xattr path, so this alone is sufficient — no need
# for --no-mac-metadata, which GNU tar doesn't even recognize). Without it,
# GNU tar on a Linux host prints an "Ignoring unknown extended header keyword"
# warning per entry when it extracts or verifies an otherwise perfectly valid
# release. COPYFILE_DISABLE=1 separately stops ._ AppleDouble sidecar files.
COPYFILE_DISABLE=1 tar --no-xattrs -czf "$OUTPUT" --exclude='bin/embed-assisted-update.ts' -T "$MANIFEST"

# Print summary
SIZE=$(wc -c < "$OUTPUT" | tr -d ' ')
if command -v numfmt &>/dev/null; then
  HUMAN_SIZE=$(numfmt --to=iec "$SIZE")
elif (( SIZE >= 1048576 )); then
  HUMAN_SIZE="$((SIZE / 1048576))M"
elif (( SIZE >= 1024 )); then
  HUMAN_SIZE="$((SIZE / 1024))K"
else
  HUMAN_SIZE="${SIZE} bytes"
fi
echo "packed release artifact: $OUTPUT ($HUMAN_SIZE)"
echo "contents:"
tar tzf "$OUTPUT" | head -30 || true
ENTRY_COUNT=$(tar tzf "$OUTPUT" | wc -l | tr -d ' ')
if [[ "$ENTRY_COUNT" -gt 30 ]]; then
  echo "  ... and $((ENTRY_COUNT - 30)) more entries"
fi
