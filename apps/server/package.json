{
  "name": "@dispatch/server",
  "version": "0.33.11",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:runtime-assets": "bun ../../scripts/generate-server-runtime-assets.mjs",
    "dev": "bun run prepare:runtime-assets && bun --watch src/main.ts",
    "build": "bun run prepare:runtime-assets && tsc -p tsconfig.json",
    "start": "bun run prepare:runtime-assets && bun src/main.ts",
    "check": "bun run prepare:runtime-assets && tsc --noEmit",
    "test": "bun run prepare:runtime-assets && bash ../../scripts/server-tests-isolated.sh run",
    "test:coverage": "bun run prepare:runtime-assets && mkdir -p coverage/.tmp && bash ../../scripts/server-tests-isolated.sh run --coverage",
    "test:watch": "bun run prepare:runtime-assets && bash ../../scripts/server-tests-isolated.sh",
    "db:migrate": "bun run prepare:runtime-assets && bun src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "bcryptjs": "^3.0.3",
    "croner": "^10.0.1",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.5",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.18.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.2",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
