{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dispatch-site",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "dispatch.berad.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
