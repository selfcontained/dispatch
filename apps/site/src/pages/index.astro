---
import Base from "../layouts/Base.astro";
---

<Base
  title="A workspace for you and your AI agents"
  description="Organize projects and tasks, work with Claude Code and Codex, and review their results. Run Dispatch locally with your existing subscriptions."
>
  <section class="hero">
    <div class="eyebrow" aria-hidden="true">
      <span class="glyph">⠋</span>
    </div><h1>A workspace for you<br /><span>and your AI agents.</span></h1><p>
      Organize projects and tasks. Put agents to work. Follow their progress,
      answer questions, and review what they produce.
    </p><div class="provider-line">
      <strong>Claude Code and Codex</strong><span
        >Keep using your existing subscriptions.</span
      >
    </div><div class="actions">
      <a class="cta" href="/start">Get started ↗</a><a href="/#product"
        >Take a look ↓</a
      >
    </div><p class="expect">Local-first. macOS + Linux.</p>
  </section>
  <section class="board-section" id="product">
    <div class="section-intro">
      <h2>See the work across your project.</h2><p>
        Track tasks on a kanban board, see which agents are working, and choose
        what moves forward.
      </p>
    </div><figure
      class="capture board-capture"
      tabindex="0"
      aria-label="Project board screenshot, horizontally scrollable on small screens"
    >
      <a
        class="capture-link"
        href="/captures/kanban-board.webp"
        download="dispatch-kanban-board.webp"
        aria-label="Download full-resolution Dispatch kanban board with research, writing, coding and review tasks"
        ><img
          width="1920"
          height="800"
          fetchpriority="high"
          src="/captures/kanban-board.webp"
          alt="Dispatch kanban board with research, writing, coding and review tasks"
        /></a
      ><figcaption>Dispatch development build · staged project data</figcaption>
    </figure>
  </section>
  <section class="stream-section">
    <div class="stream-copy">
      <span class="kicker">THE AGENT STREAM</span><h2>
        Stay in the conversation.
      </h2><p>
        Give direction, answer questions, and open the files and links an agent
        shares. Keep feedback and review findings with the work.
      </p>
    </div><figure class="capture stream-capture">
      <a
        class="capture-link"
        href="/captures/agent-stream-focus.webp"
        download="dispatch-agent-stream.webp"
        aria-label="Download full-resolution Dispatch agent stream with a shared synthesis and a question awaiting input"
        ><picture
          ><source
            width="390"
            height="900"
            media="(max-width:600px)"
            srcset="/captures/agent-stream-mobile.webp"
          /><img
            width="960"
            height="1144"
            loading="lazy"
            decoding="async"
            src="/captures/agent-stream-focus.webp"
            alt="Dispatch stream showing shared findings and an open question"
          /></picture
        ></a
      ><figcaption>Actual agent stream · staged conversation</figcaption>
    </figure>
  </section>
  <section class="section">
    <h2>Make the process your own.</h2><div class="concepts">
      <div class="concept">
        <h3><a href="/docs/workflows">Workflows</a></h3><p>
          Configure task stages and launch an agent when work enters a column.
        </p>
      </div><div class="concept">
        <h3><a href="/docs/personas">Personas</a></h3><p>
          Save roles and instructions for the agents you use again.
        </p>
      </div><div class="concept">
        <h3><a href="/docs/reviews">Owner reviews</a></h3><p>
          Map project files to reviewers, then track their findings.
        </p>
      </div>
    </div>
    <div class="end" id="setup">
      <div>
        <h2>Run Dispatch on your machine.</h2><p>
          Connect Claude Code and Codex with the accounts you already use.
        </p>
      </div><a class="cta" href="/start">Get started ↗</a>
    </div>
  </section>
</Base>

<script>
  const frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
  const motion = document.querySelector<HTMLButtonElement>("#motion");
  const glyph = document.querySelector<HTMLElement>(".glyph");
  const preference = matchMedia("(prefers-reduced-motion: reduce)");
  let paused = preference.matches;
  let frame = 0;
  function label() {
    if (!motion) return;
    motion.textContent = paused ? "Play motion" : "Pause motion";
    motion.setAttribute("aria-pressed", String(paused));
  }
  label();
  preference.addEventListener("change", (event) => {
    paused = event.matches;
    label();
  });
  motion?.addEventListener("click", () => {
    paused = !paused;
    label();
  });
  window.setInterval(() => {
    if (!paused && !document.hidden && glyph)
      glyph.textContent = frames[++frame % frames.length];
  }, 110);
</script>
