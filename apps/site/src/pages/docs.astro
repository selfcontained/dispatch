---
import Base from "../layouts/Base.astro";
import { guides } from "../content/guides";
---

<Base
  title="Docs"
  description="Start an agent, organize tasks, configure workflows and personas, review results, and manage your Dispatch installation."
>
  <section class="page-head">
    <span class="page-kicker">DOCS</span><h1>Use Dispatch.</h1><p>
      Find the next step for the work in front of you.
    </p>
  </section><div class="docs-content">
    <a class="docs-start-link" id="install" href="/start"
      ><span>New here?</span> Get Dispatch running →</a
    ><section class="docs-grid" aria-label="Usage guides">
      {
        guides.map((guide) => (
          <a class:list={["doc-card", guide.color]} href={`/docs/${guide.id}`}>
            <>
              <span class="doc-card-label">{guide.label}</span>
              <h2>{guide.title}</h2>
              <p>{guide.desc}</p>
              <span class="card-arrow" aria-hidden="true">
                ↗
              </span>
            </>
          </a>
        ))
      }
    </section><p class="docs-footnote">
      For source and contributor references, visit <a
        href="https://github.com/selfcontained/dispatch/tree/main/docs"
        >the repository docs</a
      > or open the in-app Docs.
    </p>
  </div>
</Base>
