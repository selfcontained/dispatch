---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
---
<Base title="Roadmap">
  <PageIntro eyebrow="Roadmap" title="A record of current attention, not a promise machine.">This should be a working notebook: concrete enough to be useful, uncertain enough to remain honest.</PageIntro>
  <section class="content-section" style="padding-top: 0; border-top: 0"><div class="roadmap"><section><p class="status">NOW</p><h2>Public documentation</h2><ul><li>Establish the conceptual model.</li><li>Turn product knowledge into durable guides.</li><li>Document real examples as they happen.</li></ul></section><section><p class="status">NEXT</p><h2>Sharper collaboration primitives</h2><ul><li>Continue refining messages, reviews, and context sharing.</li><li>Make long-running work easier to inspect and recover.</li></ul></section><section><p class="status">EXPLORING</p><h2>Emergent workflows</h2><ul><li>Learn which capabilities people repeatedly compose.</li><li>Find where the system should offer structure without prescription.</li></ul></section></div></section>
</Base>
