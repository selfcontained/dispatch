# Production server settings. For local development, use bin/dispatch-dev
# which auto-selects free ports and creates an isolated database.

DISPATCH_HOST=127.0.0.1
DISPATCH_PORT=6767
# Optional trusted browser origins for reverse proxies that rewrite Host or terminate TLS.
# Same-origin requests work automatically, including passwordless LAN dev previews.
# Comma-separated exact origins, no paths or trailing slash; forwarded headers are not trusted.
# DISPATCH_ALLOWED_ORIGINS=https://dispatch.example.com
DATABASE_URL=postgres://dispatch:dispatch@127.0.0.1:5432/dispatch
DISPATCH_FILES_ROOT=~/.dispatch/files

# Agent runtime — "tmux" (default when tmux is installed) or "inert" (no-op, for dev/test)
# DISPATCH_AGENT_RUNTIME=tmux

# Virtual X display for clipboard image paste on Linux (requires Xvfb + xclip)
# DISPATCH_COPY_DISPLAY=:99

# TLS (optional — both must be set to enable HTTPS)
# TLS_CERT=~/.dispatch/tls/cert.pem
# TLS_KEY=~/.dispatch/tls/key.pem
